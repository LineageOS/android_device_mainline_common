apex {
    name: "org.lineageos.device.graphics.vulkan.swiftshader",
    defaults: ["org.lineageos.device.graphics.vulkan.swiftshader_defaults"],
    manifest: "apex_manifest.json",

    prebuilts: [
        "org.lineageos.device.graphics.vulkan.swiftshader.rc",
    ],
}

apex_defaults {
    name: "org.lineageos.device.graphics.vulkan.swiftshader_defaults",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: ":org.lineageos.device.graphics.vulkan.swiftshader_apex_file_contexts",
    updatable: false,
    vendor: true,

    // Zygote GL preloading expects 32-bit /lib/ copies
    // of the native_shared_libs.
    compile_multilib: "both",

    native_shared_libs: [
        "vulkan.pastel",
    ],
    prebuilts: [
        "android.hardware.vulkan.compute-0.prebuilt.xml",
        "android.hardware.vulkan.level-1.prebuilt.xml",
        "android.hardware.vulkan.version-1_3.prebuilt.xml",
        "android.software.opengles.deqp.level-latest.prebuilt.xml",
        "android.software.vulkan.deqp.level-latest.prebuilt.xml",
        "org.lineageos.device.graphics.vulkan.swiftshader-linker-config",
    ],
}

filegroup {
    name: "org.lineageos.device.graphics.vulkan.swiftshader_apex_file_contexts",
    srcs: ["apex_file_contexts"],
}

filegroup {
    name: "org.lineageos.device.graphics.vulkan.swiftshader.rc_filegroup",
    srcs: ["org.lineageos.device.graphics.vulkan.swiftshader.rc"],
}

linker_config {
    name: "org.lineageos.device.graphics.vulkan.swiftshader-linker-config",
    src: "apex_linkerconfig.json",
    installable: false,
}

prebuilt_etc {
    name: "org.lineageos.device.graphics.vulkan.swiftshader.rc",
    src: ":org.lineageos.device.graphics.vulkan.swiftshader.rc_filegroup",
    installable: false,
}
