ifeq ($(USES_DEVICE_MAINLINE_COMMON),true)
ifneq ($(LINEAGE_BUILD),)
ifneq ($(TARGET_NO_KERNEL),true)
ifeq ($(TARGET_PREBUILT_KERNEL),)

INSTALLED_PREBUILT_KERNEL_DIR := $(PRODUCT_OUT)/prebuilt-kernel
INSTALLED_PREBUILT_KERNEL := $(INSTALLED_PREBUILT_KERNEL_DIR)/kernel

ifdef BOARD_INCLUDE_DTB_IN_BOOTIMG
$(INSTALLED_PREBUILT_KERNEL): $(PRODUCT_OUT)/dtb.img
endif # BOARD_INCLUDE_DTB_IN_BOOTIMG
$(INSTALLED_PREBUILT_KERNEL): $(PRODUCT_OUT)/kernel $(BOARD_PREBUILT_DTBOIMAGE)
	rm -rf $(INSTALLED_PREBUILT_KERNEL_DIR)
	mkdir -p $(INSTALLED_PREBUILT_KERNEL_DIR)
	if grep -q '=m' $(PRODUCT_OUT)/obj/KERNEL_OBJ/.config; then\
		cp `find $(PRODUCT_OUT)/obj/KERNEL_OBJ/ -type f -name "*.ko"` $(INSTALLED_PREBUILT_KERNEL_REPO_DIR)/;\
	fi
	$(if $(BOARD_INCLUDE_DTB_IN_BOOTIMG),cp $($(PRODUCT_OUT)/dtb.img) $(INSTALLED_PREBUILT_KERNEL_DIR)/dtb.img)
	$(if $(BOARD_PREBUILT_DTBOIMAGE),cp $(BOARD_PREBUILT_DTBOIMAGE) $(INSTALLED_PREBUILT_KERNEL_DIR)/dtbo.img)
	cp $(PRODUCT_OUT)/kernel $@

.PHONY: prebuilt-kernel-dir
prebuilt-kernel-dir: $(INSTALLED_PREBUILT_KERNEL)

endif # !TARGET_PREBUILT_KERNEL
endif # !TARGET_NO_KERNEL
endif # LINEAGE_BUILD
endif # USES_DEVICE_MAINLINE_COMMON
