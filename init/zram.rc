# ZRAM
on early-init
    exec u:r:modprobe:s0 -- /system/bin/modprobe -d /system/lib/modules zram.ko

on init
    write /sys/block/zram0/comp_algorithm lz4

on property:sys.bootstat.first_boot_completed=1
    swapon_all
