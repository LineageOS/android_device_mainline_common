prebuilt_defaults {
    name: "mainline_common_init_defaults",
    enabled: select(soong_config_variable("mainline_common_init", "enabled"), {
        true: true,
        default: false,
    }),
}

prebuilt_etc {
    name: "init.mainline.rc",
    defaults: ["mainline_common_init_defaults"],
    src: "init.mainline.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.mainline.rc",
    defaults: ["mainline_common_init_defaults"],
    src: "init.recovery.mainline.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "ueventd.mainline.rc",
    defaults: ["mainline_common_init_defaults"],
    src: "ueventd.rc",
    filename_from_src: true,
    vendor: true,
}

prebuilt_etc {
    name: "zram.rc",
    defaults: ["mainline_common_init_defaults"],
    src: "zram.rc",
    sub_dir: "init",
    vendor: true,
}
