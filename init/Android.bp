prebuilt_etc {
    name: "init.mainline.rc",
    src: "init.mainline.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.mainline.rc",
    src: "init.recovery.mainline.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "ueventd.mainline.rc",
    src: "ueventd.rc",
    filename_from_src: true,
    vendor: true,
}
