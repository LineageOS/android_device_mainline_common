allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default graphics_device:dir search;
allowxperm hal_graphics_allocator_default graphics_device:chr_file ioctl {
    FBIO_ALLOC
    FBIO_CURSOR
    FBIO_FREE
    FBIO_WAITFORVSYNC
    FBIOBLANK
    FBIOGET_CON2FBMAP
    FBIOGET_DISPINFO
    FBIOGET_FSCREENINFO
    FBIOGET_GLYPH
    FBIOGET_HWCINFO
    FBIOGET_VBLANK
    FBIOGET_VSCREENINFO
    FBIOGETCMAP
    FBIOPAN_DISPLAY
    FBIOPUT_CON2FBMAP
    FBIOPUT_MODEINFO
    FBIOPUT_VSCREENINFO
    FBIOPUTCMAP
};
gpu_access(hal_graphics_allocator_default)
