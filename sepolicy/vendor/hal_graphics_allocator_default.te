allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default graphics_device:dir search;
allowxperm hal_graphics_allocator_default graphics_device:chr_file ioctl {
  FBIO_ALLOC
  FBIOBLANK
  FBIO_CURSOR
  FBIO_FREE
  FBIOGETCMAP
  FBIOGET_CON2FBMAP
  FBIOGET_DISPINFO
  FBIOGET_FSCREENINFO
  FBIOGET_GLYPH
  FBIOGET_HWCINFO
  FBIOGET_VBLANK
  FBIOGET_VSCREENINFO
  FBIOPAN_DISPLAY
  FBIOPUTCMAP
  FBIOPUT_CON2FBMAP
  FBIOPUT_MODEINFO
  FBIOPUT_VSCREENINFO
  FBIO_WAITFORVSYNC
};
gpu_access(hal_graphics_allocator_default)
