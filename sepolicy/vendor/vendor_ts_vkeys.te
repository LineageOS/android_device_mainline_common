type vendor_ts_vkeys, domain;
type vendor_ts_vkeys_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_ts_vkeys);

recovery_only(`
    domain_trans(init, rootfs, vendor_ts_vkeys)
')

allow vendor_ts_vkeys input_device:dir r_dir_perms;
allow vendor_ts_vkeys input_device:chr_file rw_file_perms;
allow vendor_ts_vkeys kmsg_device:chr_file rw_file_perms;
allow vendor_ts_vkeys uhid_device:chr_file rw_file_perms;

get_prop(vendor_ts_vkeys, vendor_ts_vkeys_prop)
