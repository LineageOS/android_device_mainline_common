recovery_only(`
    get_prop(fastbootd, storage_config_prop)
    r_dir_file(fastbootd, sysfs_fs_ext4_features)

    allow fastbootd cache_block_device:blk_file rw_file_perms;
    allow fastbootd kernel:process setsched;
    allow fastbootd recovery_block_device:blk_file rw_file_perms;
    allow fastbootd sd_device:blk_file rw_file_perms;
    allow fastbootd vd_device:blk_file rw_file_perms;

    allowxperm fastbootd metadata_block_device:blk_file ioctl { BLKDISCARDZEROES BLKROGET };
    allowxperm fastbootd system_block_device:blk_file ioctl { BLKDISCARD BLKSECDISCARD };
')
