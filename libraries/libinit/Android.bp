cc_defaults {
    name: "init_mainline_common_defaults",
    whole_static_libs: ["libinit_mainline_common"],
    include_dirs: ["system/core/init"],
    recovery_available: true,
}

cc_library_static {
    name: "libinit_mainline_common",
    srcs: [
        "libinit_dalvik_heap.cpp",
        "libinit_mainline_common.cpp",
        "libinit_misc.cpp",
        "libinit_set_properties.cpp",
        "libinit_utils.cpp",
    ],
    whole_static_libs: ["libbase"],
    export_include_dirs: ["include"],
    recovery_available: true,
}

cc_library_static {
    name: "init_mainline_common",
    srcs: ["init_mainline_common.cpp"],
    defaults: ["init_mainline_common_defaults"],
    cflags: select(soong_config_variable("mainline_common_libinit", "set_properties_from"), {
        "devicetree": ["-DSET_PROPERTIES_FROM_DEVICETREE"],
        "dmi_id": ["-DSET_PROPERTIES_FROM_DMI_ID"],
        default: [],
    }),
}
