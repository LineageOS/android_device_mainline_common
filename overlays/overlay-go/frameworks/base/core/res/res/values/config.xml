<resources>
    <!--- Launcher - configure high/low-res scales for task snapshots -->
    <item name="config_highResTaskSnapshotScale" format="float" type="dimen">0.8</item>
    <item name="config_lowResTaskSnapshotScale" format="float" type="dimen">0.3</item>

    <!-- Configure 16-bit task snapshots -->
    <bool name="config_use16BitTaskSnapshotPixelFormat">true</bool>

    <!-- Whether or not swipe up gesture's opt-in setting is available on this device -->
    <bool name="config_swipe_up_gesture_setting_available">true</bool>

    <!-- True if the device requires AppWidgetService even if it does not have
         the PackageManager.FEATURE_APP_WIDGETS feature -->
    <bool name="config_enableAppWidgetService">true</bool>

    <!-- If device supports corner radius on windows.
         This should be turned off on low-end devices to improve animation performance. -->
    <bool name="config_supportsRoundedCornersOnWindows">false</bool>

    <!-- Whether WM DisplayContent supports high performance transitions
         (lower-end devices may want to disable) -->
    <bool name="config_deviceSupportsHighPerfTransitions">false</bool>
</resources>
